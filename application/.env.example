APP_NAME="tv-machine-translation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8006

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=user
DB_PASSWORD=pass

# Queue (Redis)
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Keycloak Auth
KEYCLOAK_REALM_URL=http://host.docker.internal:8180/realms/tolkevarav-dev
KEYCLOAK_CLIENT_ID=tv-machine-translation

# =====================
# eTranslation Provider
# =====================
ETRANSLATION_API_URL=https://webgate.ec.europa.eu/etranslation/si/translate
ETRANSLATION_USERNAME=
ETRANSLATION_PASSWORD=
ETRANSLATION_APP_NAME=tolkevarav
# Must be publicly reachable by the EU Commission callback:
ETRANSLATION_CALLBACK_URL=https://your-gateway.example.com/machine-translation/api/callback/etranslation
ETRANSLATION_TIMEOUT=30

# ==========================
# Azure OpenAI (Copilot) Provider
# ==========================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TIMEOUT=60

# OpenAPI / Swagger docs
L5_SWAGGER_GENERATE_ALWAYS=true
